# Keep real credentials in .env on the server; never commit them.
# Set this in the app build environment to the public HTTPS API origin, without /api.
# VITE_API_BASE_URL=https://api.your-domain.example
# On the API host, allow your web storefront origin with a comma-separated list.
# CORS_ORIGINS=https://your-storefront.example
# HOST=0.0.0.0
CHATBOT_API_KEY=replace_with_your_google_ai_studio_api_key
CHATBOT_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
CHATBOT_MODEL=gemini-3.8-flash

# Paymob Accept: fill these in only on the server after enabling an integration.
# The public checkout option stays hidden until all values are configured.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_NOTIFICATION_URL=https://your-domain.example/api/payments/paymob/webhook
PAYMOB_RETURN_URL=https://your-domain.example/payment-result
